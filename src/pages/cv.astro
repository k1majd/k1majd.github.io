---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
---

<BaseLayout title="Resume">
  <style>
    a:link {
      color: green;
      background-color: transparent;
      text-decoration: none;
    }

    a:visited {
      color: green;
      background-color: transparent;
      text-decoration: none;
    }

    a:hover {
      color: green;
      background-color: transparent;
      text-decoration: underline;
    }

    a:active {
      color: green;
      background-color: transparent;
      text-decoration: underline;
    }
  </style>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Curriculum Vitae</div>
  </div>

  <div class="mb-10 text-justify">
    Robotics Engineer specializing in behavior generation and safety-critical
    decision-making for autonomous driving. Experienced in model-based planning
    and control (MPPI/MPC), learning-enabled components including diffusion-style
    stochastic sampling and safety-aware policy adaptation, and real-time deployment
    on physical systems. Ph.D. in Computer Science from Arizona State University.
    Full CV is available <b
      ><a href="/cvs/resume_keyvan_majd.pdf">here</a>
    </b>.
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Education</div>
  </div>

  <div class="time-line-container grid gap-4 mb-10">
    <TimeLineElement
      title="Arizona State University | 2019 - 2024"
      subtitle="Ph.D. in Computer Science (GPA: 4.0/4.0)"
      desc1="Thesis: Safe Robot Learning with Neural Network Repair"
      desc2="Co-advisors: Prof. Heni Ben Amor and Prof. Georgios Fainekos"
    />
    <TimeLineElement
      title="North Carolina A&T State University | 2017 - 2019"
      subtitle="M.Sc. in Electrical Engineering (GPA: 4.0/4.0)"
      desc1="Thesis: Kinematic-based Trajectory Planning Framework for Autonomous Ground Vehicles"
    />
    <TimeLineElement
      title="Ferdowsi University of Mashhad | 2011 - 2015"
      subtitle="B.Sc. in Electrical Engineering"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Experience</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="Research Engineer | 2024 - Present"
      subtitle="Toyota Research Institute NA"
    />
    <TimeLineElement
      title="Simulation Engineer | 2024"
      subtitle="Nikola Corp."
    />
    <TimeLineElement
      title="Research Intern | 2024"
      subtitle="Honda Research Institute USA"
    />
    <TimeLineElement
      title="Graduate Research Assistant | 2019 - 2024"
      subtitle="Arizona State University"
      desc1="-Integrating imitation learning and neural network repair to derive safe policies for a robotic lower-leg prosthesis device."
      desc2="-Taking into account the human's imperfect perception via joint communication and motion planning."
      desc3="-Neural network repair for training policies with safety guarantees using Mixed-integer Programming (MIP)."
      desc4="-Comparison of AV simulators: SVL, Carla, and Webots in the context of requirements driven adversarial testing."
      desc5="-Risk-bounded control for the Toyota’s HSR robot in confined dynamic environments using Control Barrier Functions."
    />
    <TimeLineElement
      title="Graduate Teaching Assistant | 2020 "
      subtitle="Arizona State University"
      desc1="-CSE355: Introduction to Theoretical Computer Science"
    />
    <TimeLineElement
      title="Graduate Teaching Assistant | 2019 "
      subtitle="Arizona State University"
      desc1="-CSE494: Introduction to Mobile Robotics"
    />
    <TimeLineElement
      title="Graduate Research Assistant | 2017 - 2019 "
      subtitle="North Carolina A&T State University"
      desc1="-A globally exponentially stable optimal analytical solution to the classical car-like robot kinematic model trajectory tracking and control problem."
    />
    <TimeLineElement
      title="Graduate Teaching Assistant | 2017 "
      subtitle="North Carolina A&T State University"
      desc1="-CSE356: Stochastic Process and Random Variables"
    />
  </div>

  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Professional Services</div>
  </div>

  <div class="time-line-container mb-10">
    <TimeLineElement
      title="­Session chair of Motion and Path Planning in the 2021 IEEE/RSJ International Conference on Intelligent Robots and Systems (iROS) | 2021"
    />
    <TimeLineElement
      title="Member of Toyota Human Support Robot (HSR) Developer Community | 2019 - Present "
    />
    <TimeLineElement
      title="­Reviewer for Conferences | 2018 - Present "
      subtitle="IEEE Conference on Decision and Control (CDC), International Conference on Robotics and Automation (ICRA), IEEE/RSJ International Conference on Intelligent Robots and Systems (iROS), American Control Conference (ACC)"
    />
    <TimeLineElement
      title="­Reviewer for Journals | 2018 - Present "
      subtitle="IEEE Transactions on Vehicular Technology, IET Radar, Sonar & Navigation, IET Electronics Letters"
    />
    <TimeLineElement
      title="­	President of Iranian Student Association, Greensboro NC | 2017 - 2018"
    />
  </div>

