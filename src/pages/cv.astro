  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Skills</div>
  </div>

  <ul class="list-disc md:columns-5 columns-2 mx-6">
    <li>C/C++</li>
    <li>Python</li>
    <li>JAX</li>
    <li>PyTorch</li>
    <li>TensorFlow</li>
    <li>ROS1/ROS2</li>
    <li>MATLAB</li>
    <li>Gurobi</li>
    <li>CPLEX</li>
    <li>Pyomo</li>
    <li>CARLA</li>
    <li>Isaac Sim</li>
    <li>MuJoCo</li>
    <li>Gazebo</li>
    <li>IPG CarMaker</li>
    <li>CAN/SIL/HIL</li>
    <li>Git</li>
    <li>MPPI/MPC</li>
    <li>Diffusion Models</li>
    <li>Imitation Learning</li>
  </ul>
</BaseLayout>
