---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <div class="flex flex-col md:flex-row md:items-center md:gap-8">
      <div class="flex-shrink-0 mb-6 md:mb-0">
        <img
          src="/profile.jpg"
          alt="Keyvan Majd"
          class="w-36 h-36 rounded-full object-cover shadow-md mx-auto md:mx-0"
        />
      </div>
      <div>
        <div class="text-4xl font-bold">Keyvan Majd</div>
        <div class="text-xl py-2 font-bold text-base-content/90">Research Engineer @ Toyota Research Institute in NA</div>
      </div>
    </div>

    <div class="mt-6 space-y-3 text-base text-justify">
      <p>
        I am a Research Engineer at <a href="https://amrd.toyota.com/division/trina/">Toyota Research Institute of North America (TRINA)</a>.
        My research interests include motion planning and control, safe navigation with control barrier functions, safe robot learning,
        human-robot interaction, and generative models for robotics. I received my Ph.D. in Computer Science from <a href="https://asu.edu">Arizona State University</a>,
        advised by <a href="http://henibenamor.weebly.com">Heni Ben Amor</a> and
        <a href="http://fainekos.net">Georgios Fainekos</a>.
      </p>
    </div>
  </div>

  <div class="mb-12">
    <div class="text-2xl w-full font-bold mb-4">Research Projects</div>

    <HorizontalCard
      title="Safe Model Predictive Diffusion with Shielding"
      img="/projects/safe_mpd/teaser.gif"
      desc="A training-free diffusion planner that generates provably safe and kinodynamically feasible trajectories by integrating a safety shield into the denoising process of a model-based diffusion framework."
      url="https://www.taekyung.me/safe-mpd"
      badge="ICRA'26"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="NNRepLayer: Neural Network Repair for Safe Robot Learning"
      img="/projects/nnreplayer_prosthesis/tumb1.png"
      desc="Framework for repairing neural network control policies to satisfy formal safety constraints using Mixed Integer Quadratic Programming. Applied to robotic prosthesis control. Best Paper Award at NeurIPS'22 Robot Learning Workshop."
      url="https://github.com/k1majd/NNRepLayer"
      badge="CoRL'22"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Safe Navigation with Control Barrier Functions"
      img="/projects/nnreplayer_prosthesis/tumb2.gif"
      desc="Extended time-based RRTs with Control Barrier Functions for safe motion planning in dynamic environments with pedestrians. Demonstrated on Toyota HSR in narrow corridors."
      url="https://github.com/k1majd/CBF_TB_RRT"
      badge="IROS'21"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title="Open X-Embodiment: Large-Scale Robot Learning Dataset"
      img="/projects/open_x_embodiment.png"
      desc="Contributed to the Open X-Embodiment dataset — a large-scale multi-robot learning dataset supporting policy learning across diverse embodied platforms, enabling cross-embodiment generalization."
      url="https://robotics-transformer-x.github.io"
      badge="CoRL'23"
    />
  </div>

  <!-- <div class="divider my-0"></div> -->

  <!-- <br />
  <br /> -->
  <div class="mb-5">
    <div class="text-2xl w-full font-bold">News</div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Jan 2026</span>
    </div>
    <div class="pub-content text-justify">
      Our paper "Safe Model Predictive Diffusion with Shielding" has been accepted to <b>ICRA 2026</b>!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Jun 2025</span>
    </div>
    <div class="pub-content text-justify">
      Two papers accepted: "GPU-Accelerated Barrier Rate MPPI Control for Tractor-Trailer Navigation" at <b>ITSC 2025</b>,
      and "Robot Behavior Adaptation in Physical Human-Robot Interactions" at <b>IROS 2025</b>!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Dec 2024</span>
    </div>
    <div class="pub-content text-justify">
      I successfully defended my Ph.D. dissertation "Safe Robot Learning with Neural Network Repair" at Arizona State University!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Oct 2024</span>
    </div>
    <div class="pub-content text-justify">
      Joined <b>Toyota Research Institute of North America</b> as a Research Engineer, working on autonomous maneuvering and motion planning.
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Jun 2024</span>
    </div>
    <div class="pub-content text-justify">
      Our paper "Repairing Neural Networks for Safety in Robotic Systems using Predictive Models" has been accepted to <b>IROS 2024</b>!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Dec 2022</span>
    </div>
    <div class="pub-content text-justify">
      Our paper "Certifiably-correct Control Policies for Safe Learning and Adaptation in Assistive Robotics" received <b>a Best Paper Award (2nd Runner-up)</b> at NeurIPS 2022 Robot Learning Workshop!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Sep 2022</span>
    </div>
    <div class="pub-content text-justify">
      Our paper "Safe Robot Learning in Assistive Devices through Neural Network Repair" has been accepted to <b>CoRL 2022</b>!
    </div>
  </div>
</BaseLayout>
