---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";

const postImportResult = import.meta.glob('./blog/*.{md,mdx}', { eager: true });
const posts = Object.values(postImportResult).sort(
  (a, b) =>
    new Date(b.frontmatter.pubDate).valueOf() -
    new Date(a.frontmatter.pubDate).valueOf()
);

const last_posts = posts.slice(0, 5);
---

<BaseLayout>
  <div class="pb-12 mt-5">
    <div class="flex flex-col md:flex-row md:items-start md:gap-8">
      <div class="flex-shrink-0 mb-6 md:mb-0">
        <img
          src="/profile.jpg"
          alt="Keyvan Majd"
          class="w-36 h-36 rounded-full object-cover shadow-md mx-auto md:mx-0"
        />
      </div>
      <div>
        <div class="text-5xl font-bold">Keyvan Majd</div>
        <div class="text-3xl py-3 font-bold text-base-content/70">Research Engineer @ Toyota Research Institute in NA</div>
      </div>
    </div>

    <div class="mt-8 space-y-4 text-lg text-justify">
      <p>
        I am a Research Engineer at <b>Toyota Research Institute of North America (TRINA)</b>,
        where I work on safety-critical autonomy for real-world robotic systems. My work spans
        <b>motion planning and control</b>, <b>safe robot learning</b>, <b>human-robot interaction</b>,
        and <b>generative models for robotics</b> with a unifying focus on deploying systems that
        are both capable and provably safe.
      </p>
      <p>
        At TRINA, I build real-time planning and control systems for autonomous maneuvering of articulated vehicles,
        combining model-based optimization with diffusion-inspired trajectory sampling. Previously, I developed SIL/HIL simulation
        pipelines for ADAS validation at <b>Nikola Corporation</b>, and built real-time adaptive safety
        controllers for physical human-robot interaction at <b>Honda Research Institute</b>.
      </p>
      <p>
        My research on <b>neural network repair</b>, where learned control policies are formally corrected
        to satisfy safety constraints via mixed-integer optimization, has been published at
        CoRL, ICRA, IROS, and received a <b>Best Workshop Paper Award at NeurIPS 2022</b>. I have also contributed to
        risk-bounded control using stochastic barrier functions, behavior-aware motion planning for
        collaborative robots, and the Open X-Embodiment large-scale robot learning dataset.
      </p>
      <p>
        I received my Ph.D. in Computer Science from <a href="https://asu.edu">Arizona State University</a> in 2024,
        co-advised by <a href="http://henibenamor.weebly.com">Prof. Heni Ben Amor</a> and
        <a href="http://fainekos.net">Prof. Georgios Fainekos</a>.
        I hold an M.Sc. in Electrical Engineering from <a href="https://www.ncat.edu">North Carolina A&T State University</a>
        and a B.Sc. from <a href="https://en.um.ac.ir">Ferdowsi University of Mashhad</a>.
      </p>
    </div>
  </div>

  <div class="mb-12">
    <div class="text-3xl w-full font-bold mb-4">Past research projects</div>
    <HorizontalCard
      title={last_posts[0].frontmatter.title}
      img={last_posts[0].frontmatter.heroImage}
      desc={last_posts[0].frontmatter.description}
      url={last_posts[0].url}
      badge={last_posts[0].frontmatter.badge}
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title={last_posts[1].frontmatter.title}
      img={last_posts[1].frontmatter.heroImage}
      desc={last_posts[1].frontmatter.description}
      url={last_posts[1].url}
      badge={last_posts[1].frontmatter.badge}
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title={last_posts[2].frontmatter.title}
      img={last_posts[2].frontmatter.heroImage}
      desc={last_posts[2].frontmatter.description}
      url={last_posts[2].url}
      badge={last_posts[2].frontmatter.badge}
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title={last_posts[3].frontmatter.title}
      img={last_posts[3].frontmatter.heroImage}
      desc={last_posts[3].frontmatter.description}
      url={last_posts[3].url}
      badge={last_posts[3].frontmatter.badge}
      target="_self"
    />
    <div class="divider my-0"></div>
    <HorizontalCard
      title={last_posts[4].frontmatter.title}
      img={last_posts[4].frontmatter.heroImage}
      desc={last_posts[4].frontmatter.description}
      url={last_posts[4].url}
      badge={last_posts[4].frontmatter.badge}
      target="_self"
    />
  </div>

  <!-- <div class="divider my-0"></div> -->

  <!-- <br />
  <br /> -->
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">News</div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Jan 2026</span>
    </div>
    <div class="pub-content text-justify">
      Our paper "Safe Model Predictive Diffusion with Shielding" has been accepted to <b>ICRA 2026</b>!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Jun 2025</span>
    </div>
    <div class="pub-content text-justify">
      Two papers accepted: "GPU-Accelerated Barrier Rate MPPI Control for Tractor-Trailer Navigation" at <b>ITSC 2025</b>,
      and "Robot Behavior Adaptation in Physical Human-Robot Interactions" at <b>IROS 2025</b>!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Dec 2024</span>
    </div>
    <div class="pub-content text-justify">
      I successfully defended my Ph.D. dissertation "Safe Robot Learning with Neural Network Repair" at Arizona State University!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Oct 2024</span>
    </div>
    <div class="pub-content text-justify">
      Joined <b>Toyota Research Institute of North America</b> as a Research Engineer, working on autonomous maneuvering and motion planning.
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Jun 2024</span>
    </div>
    <div class="pub-content text-justify">
      Our paper "Repairing Neural Networks for Safety in Robotic Systems using Predictive Models" has been accepted to <b>IROS 2024</b>!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Dec 2022</span>
    </div>
    <div class="pub-content text-justify">
      Our paper <a href="/papers/Neurips22.pdf">"Certifiably-correct Control Policies for Safe Learning and Adaptation in Assistive Robotics"</a>
      received <b>a Best Paper Award (2nd Runner-up)</b> at NeurIPS 2022 Robot Learning Workshop!
    </div>
  </div>

  <div class="pub-row">
    <div class="pub-badge">
      <span class="badge badge-outline">Sep 2022</span>
    </div>
    <div class="pub-content text-justify">
      Our paper <a href="https://openreview.net/forum?id=X4228W0QpvN">"Safe Robot Learning in Assistive Devices through Neural Network Repair"</a>
      has been accepted to <a href="https://corl2022.org">CoRL 2022</a>!
    </div>
  </div>
</BaseLayout>
