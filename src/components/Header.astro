<!-- Mobile-only top bar (visible < md) -->
<div class="sticky md:hidden top-0 z-30 flex h-14 w-full items-center justify-between px-4 bg-base-100/90 backdrop-blur border-b border-base-300/30">
  <button id="mobile-menu-toggle" class="p-2 rounded-lg hover:bg-base-300/50 transition-colors" aria-label="Open menu">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
  <a class="text-lg font-semibold" href="/">Keyvan Majd</a>
  <button id="theme-toggle" class="p-2 rounded-lg hover:bg-base-300/50 transition-colors" aria-label="Toggle dark mode">
    <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="display:none;">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
    </svg>
    <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
    </svg>
  </button>
</div>
<script is:inline>
  (function() {
    // Mobile hamburger → open sidebar
    const mobileToggle = document.getElementById('mobile-menu-toggle');
    if (mobileToggle) {
      mobileToggle.addEventListener('click', () => {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebar-overlay');
        if (sidebar) sidebar.classList.toggle('mobile-open');
        if (overlay) overlay.classList.toggle('active');
      });
    }

    // Mobile dark mode toggle
    const toggle = document.getElementById('theme-toggle');
    const sun = document.getElementById('sun-icon');
    const moon = document.getElementById('moon-icon');
    function updateIcons() {
      const current = document.documentElement.getAttribute('data-theme');
      if (current === 'black') {
        sun.style.display = 'block';
        moon.style.display = 'none';
      } else {
        sun.style.display = 'none';
        moon.style.display = 'block';
      }
    }
    updateIcons();
    if (toggle) {
      toggle.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        const next = current === 'black' ? 'wireframe' : 'black';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        updateIcons();
        // Sync sidebar icons
        const sSun = document.getElementById('sidebar-sun-icon');
        const sMoon = document.getElementById('sidebar-moon-icon');
        const sLabel = document.getElementById('sidebar-theme-label');
        if (sSun && sMoon) {
          sSun.style.display = next === 'black' ? 'block' : 'none';
          sMoon.style.display = next === 'black' ? 'none' : 'block';
        }
        if (sLabel) sLabel.textContent = next === 'black' ? 'Light mode' : 'Dark mode';
      });
    }
  })();
</script>
